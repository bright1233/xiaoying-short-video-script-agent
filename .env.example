# Copy to .env. Add a Beijing-region Model Studio pay-as-you-go API key.
# Never commit the real key. Do not use Coding Plan / Token Plan keys in this backend.
# Beijing legacy URL works for a first run. Prefer the workspace-specific URL later:
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# If your key belongs to another region, replace the Base URL with that region's URL.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
MODEL_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=10
